          ]
        },
        "recovery": "re_authenticate",
        "max_retries": 1,
        "backoff_ms": 2000
      },
      {
        "code": "TRANSIENT_LOAD",
        "recognizer": {
          "all": [
            {"type": "timeout", "after_ms": 5000}
          ]
        },
        "recovery": "wait_and_retry",
        "max_retries": 3,
        "backoff_ms": 2000
