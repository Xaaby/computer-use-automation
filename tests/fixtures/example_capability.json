{
  "schema_version": "1.0",
  "id": "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee",
  "name": "member.lookup_savings_balance",
  "version": "1.0.0",
  "description": "Look up a member by ID and read the savings account balance.",
  "created_at": "2026-08-16T00:00:00Z",
  "target": {
    "surface_type": "playwright_web",
    "app_family": "mock_core_admin",
    "app_version": "1.0",
    "entry_point": "http://localhost:5000/members/search"
  },
  "policy": {
    "risk_class": "read_only",
    "allowed_actions": ["navigate", "fill", "click", "read"],
    "allowed_routes": [
