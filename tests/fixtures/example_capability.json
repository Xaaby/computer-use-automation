      "http://localhost:5000/frames/**"
    ]
  },
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "required": true,
      "pattern": "^[0-9]+$",
      "description": "Member identifier to look up"
    }
  ],
  "steps": [
    {
      "id": "step_1",
      "description": "Navigate to member search",
      "action": "navigate",
      "url": "http://localhost:5000/members/search",
      "risk_level": "safe",
      "preconditions": [],
      "postconditions": [
        {"type": "route_matches", "pattern": "*/members/search*"}
      ]
    },
    {
      "id": "step_2",
      "description": "Fill member ID",
      "action": "fill",
      "value": "$inputs.member_id",
      "risk_level": "safe",
      "target": {
        "frame_path": null,
        "expected_matches": 1,
        "candidates": [
          {
            "priority": 1,
            "strategy": "role",
            "role": "textbox",
            "name": "Member ID",
            "exact": true
          },
          {
            "priority": 2,
            "strategy": "label",
            "text": "Member ID",
            "exact": true
          }
        ]
      },
      "preconditions": [
        {"type": "route_matches", "pattern": "*/members/search*"}
      ],
      "postconditions": []
    },
    {
      "id": "step_3",
      "description": "Click Search",
      "action": "click",
      "risk_level": "safe",
      "target": {
        "frame_path": null,
        "expected_matches": 1,
        "candidates": [
          {
            "priority": 1,
            "strategy": "text",
            "text": "Search",
            "exact": true
          }
        ]
      },
      "preconditions": [
        {"type": "route_matches", "pattern": "*/members/search*"}
      ],
      "postconditions": []
    },
    {
      "id": "step_4",
      "description": "Read savings balance from accounts iframe",
      "action": "read",
      "output_name": "savings_balance",
      "risk_level": "safe",
      "target": {
        "frame_path": "iframe[title=\"Accounts\"]",
        "expected_matches": 1,
        "candidates": [
          {
            "priority": 1,
            "strategy": "role",
            "role": "cell",
            "name": "4821.50",
            "exact": true
          }
        ]
      },
      "preconditions": [
        {"type": "route_matches", "pattern": "*/members/*"}
      ],
      "postconditions": []
    }
  ],
  "outputs": [
    {
      "name": "savings_balance",
      "type": "string",
      "description": "Savings account balance for the member",
      "extract": {
        "frame_path": "iframe[title=\"Accounts\"]",
        "strategy": "role",
        "role": "cell",
        "method": "text_content"
      }
    }
  ],
  "success_condition": {
    "checkpoint_id": "at_members_detail",
    "description": "Look up a member by ID and read the savings account balance."
  },
  "checkpoints": {
    "at_members_search": {
      "all": [
        {"type": "route_matches", "pattern": "*/members/search*"}
      ]
    },
    "at_members_detail": {
      "all": [
        {"type": "route_matches", "pattern": "*/members/*"}
      ]
    }
  },
  "business_outcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
